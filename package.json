{
  "name": "wethu-lenders-static",
  "version": "1.0.0",
  "private": true,
  "description": "Static marketing website for Wethu Micro Lenders. No runtime dependencies.",
  "scripts": {
    "lint:html": "html-validate \"**/*.html\"",
    "lint:css": "stylelint \"Static/**/*.css\"",
    "lint:links": "linkinator . --recurse --skip \"^https?://\"",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "html-validate": "^9.0.0",
    "linkinator": "^6.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0"
  }
}